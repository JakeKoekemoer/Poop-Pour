# Application Configuration
# Show coming soon page (true/false)
VITE_SHOW_COMING_SOON=true

# Launch date for countdown timer (ISO 8601 format)
VITE_LAUNCH_DATE=2026-03-01T00:00:00

# API Configuration
# Base URL for the backend API
VITE_API_URL=http://localhost:5000

# Public WebApi User API Key for the backend API
# This key is used as fallback authentication when no user access token is available
# Used for unauthenticated endpoints (like login/register) and initial API access
VITE_API_KEY=