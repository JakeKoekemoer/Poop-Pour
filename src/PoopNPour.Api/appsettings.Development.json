{
  "RegenerateApiTokensOnStartup": true,
  "Jwt": {
    "SecretKey": "DevelopmentSecretKey_MustBeAtLeast32CharactersLong_ChangeInProduction",
    "Issuer": "PoopNPour",
    "Audience": "PoopNPour",
    "ExpirationInMinutes": 60,
    "ApiTokenExpirationInDays": 3650
  },
  "DefaultAdmin": {
    "UserName": "admin",
    "Email": "admin@poopnpour.com",
    "Password": "Admin@123",
    "FirstName": "Admin",
    "LastName": "User"
  },
  "ApiClients": [
    {
      "UserName": "webapi",
      "Email": "webapi@poopnpour.com",
      "Password": "WebApi@123!Secure",
      "Role": "Web_Api",
      "FirstName": "Web",
      "LastName": "API Client"
    },
    {
      "UserName": "mobileapi",
      "Email": "mobileapi@poopnpour.com",
      "Password": "MobileApi@123!Secure",
      "Role": "Mobile_Api",
      "FirstName": "Mobile",
      "LastName": "API Client"
    }
  ],
  "EntityFramework": {
    "CommandTimeout": 30,
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true,
    "EnableServiceProviderCaching": true,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 3,
    "MaxRetryDelay": "00:00:30"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
